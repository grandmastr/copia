[Unit]
Description=Copia clipboard server
Documentation=file://__COPIA_DIR__/src/README.md

[Service]
EnvironmentFile=__COPIA_DIR__/copia.env
Environment=COPIA_DATA=__COPIA_DIR__/data
WorkingDirectory=__COPIA_DIR__
ExecStart=__COPIA_DIR__/bin/copia-server
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
