# Copia client configuration.
#
# Copy this file to ~/.config/copia/copia.env on each computer (Linux and Mac),
# fill it in, and make it private:
#
#   mkdir -p ~/.config/copia
#   cp copia.env.example ~/.config/copia/copia.env
#   chmod 600 ~/.config/copia/copia.env
#
# Never commit the filled-in file: it contains your token.

# Address of your Copia server (required). Use a name or IP your devices can
# reach, e.g. its Tailscale MagicDNS name or its LAN IP.
COPIA_SERVER=http://your-server:8787

# Shared token (required). The server's deploy script generates one in
# ~/copia/copia.env on the server; copy the same value here.
COPIA_TOKEN=paste-your-token-here

# Name shown for this device (optional; defaults to the computer's hostname).
# COPIA_DEVICE=my-laptop
